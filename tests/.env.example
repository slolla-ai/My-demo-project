# Copy to tests/.env and fill in real values — never commit tests/.env itself.

E2E_BASE_URL=http://localhost:4200

# Manager account — Alerts at Geofence report access is gated by a global
# feature toggle (alertsAtGeofenceReportEnabled), not a per-user permission,
# so only one account is needed (see TC-SGA-007 / fixtures/auth.setup.ts).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Test data — real Asset/Geofence names in the target account, matching the
# Alerts at Geofence report's Target + Geofence filters.
E2E_SGA_ASSET_NAME=TRL-001
E2E_SGA_GEOFENCE_NAME=Main Yard
E2E_SGA_ASSET_WITH_ARRIVAL_ALERTS=TRL-ALERT-001
E2E_SGA_OPEN_CROSSING_ASSET=TRL-OPEN-001
E2E_SGA_RECENT_DEPARTURE_ASSET=TRL-RECENT-001
E2E_SGA_EMPTY_RESULT_GEOFENCE=Empty Test Geofence
E2E_SGA_MANY_CROSSINGS_GEOFENCE=High Traffic Yard
